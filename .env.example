# Bu dosyayı .env.local olarak kopyalayın (.env*.local git'e girmez).
# RevenueCat > Project settings > API keys altındaki public SDK anahtarları.
# Boş bırakılırsa uygulama ücretsiz modda çalışır; geliştirmede Premium simüle edilebilir.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# Hasfiyat API anahtarı (gizli). EXPO_PUBLIC_ öneki KOYMAYIN: yalnızca app/api/prices+api.ts
# sunucu ucunda okunur, uygulama paketine girmez. Üretimde EAS Hosting ortam değişkeni olarak
# tanımlanır. Fiyatların tek kaynağıdır; boşsa fiyat gelmez.
HASFIYAT_API_KEY=

# Ekonomik takvimde açıklanan değerler (gizli; EXPO_PUBLIC_ öneki KOYMAYIN). Yalnızca
# app/api/calendar+api.ts sunucu ucunda okunur. Boş bırakılırsa takvim yine çalışır, ilgili
# sonuçlar "Sonuç bekleniyor" görünür. TCMB faiz kararı anahtarsız TCMB sayfasından gelir.
# FRED (Fed faizi, ABD TÜFE, istihdam): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# TCMB EVDS (TÜİK TÜFE): https://evds3.tcmb.gov.tr > Profilim > API Key
EVDS_API_KEY=

# Ticari kullanımı yazılı izne bağlı kaynaklar (sunucu; izin alınınca 1 yapılır, varsayılan kapalı).
# TCMB: Piyasa Katılımcıları Anketi beklentileri ve karar metninden alıntı/ton (raporlarda).
TCMB_COMMERCIAL_PERMISSION=
# Cleveland Fed: ABD enflasyon anlık tahmini (raporlarda). Açınca Veri kaynakları listesine de ekleyin.
CLEVELAND_FED_PERMISSION=

# Yayımlanan kullanım koşulları ve gizlilik politikası sayfaları (herkese açık adresler; taslaklar
# docs/legal/). Boşsa Ayarlar ve ödeme ekranındaki bağlantılar gizlenir; mağazalar ikisini de ister.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Haftalık analizlerin JSON dosyası (herkese açık adres; biçim: firebase/public/weekly-analyses.json).
# Boşsa aynı dosya uygulamanın kendi sunucusundan (/api/weekly) okunur; o zaman yeni hafta ancak
# sunucu yeniden yayımlanınca görünür. Liste boşsa "Haftalık analiz" bölümü gizlenir.
EXPO_PUBLIC_WEEKLY_ANALYSIS_URL=

# Uygulama kapalıyken fiyat alarmı bildirimi (Firebase; kurulum: docs/FIREBASE_ALARM_KURULUM.md).
# Dağıtılan `syncAlarms` Cloud Function adresi. Boşsa alarmlar yalnızca uygulama açıkken kontrol edilir.
EXPO_PUBLIC_ALARM_SYNC_URL=
# Cloud Functions'ın /api/alarm-values ucunu çağırırken gönderdiği gizli anahtar (sunucu; EXPO_PUBLIC_
# öneki KOYMAYIN). Aynı değer Firebase'de `ALARM_SERVER_SECRET` gizli anahtarı olarak da tanımlanır.
ALARM_SERVER_SECRET=

# Ürün analitiği (PostHog; https://posthog.com). Proje API anahtarı herkese açık (phc_...) bir
# anahtardır. Boşsa hiçbir olay gönderilmez. Host: AB için https://eu.i.posthog.com, ABD için
# https://us.i.posthog.com. Gönderilen olaylar src/data/datasources/analyticsDatasource.ts'de.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
# Paylaşım görselinin altında yazılan mağaza bağlantısı (yayın sonrası App Store/Play adresi).
EXPO_PUBLIC_STORE_URL=
# Puan isteğinde "Pek değil" diyen kullanıcının yönlendirileceği geri bildirim e-postası. Boşsa bu adım atlanır.
EXPO_PUBLIC_SUPPORT_EMAIL=

# --- Hesap bağlama (Ayarlar > Hesap: Google / Apple ile bağla) ---
# Dördü de boşsa bölüm görünmez. Firebase Console > Proje ayarları > Web API anahtarı.
EXPO_PUBLIC_FIREBASE_API_KEY=
# `account` Cloud Function adresi (deploy çıktısındaki URL).
EXPO_PUBLIC_ACCOUNT_API_URL=https://us-central1-altin-kasam-628d2.cloudfunctions.net/account
# Firebase Auth > Google sağlayıcısı > "Web SDK configuration" altındaki Web client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=390446506389-9cc98q433eusa6ogrss9fp23keai7384.apps.googleusercontent.com
# Google Cloud > Credentials > iOS OAuth client ID (bundle: com.furkanages.altinkasam). iOS URL şeması bundan türetilir.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
