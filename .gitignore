google-services.json
GoogleService-Info.plist

# Firebase / Google servis hesabı anahtarları (gizli)
*-firebase-adminsdk-*.json
*service-account*.json

# Editör yerel geçmişi (Local History eklentisi)
.history/

# Tüm yerel env dosyaları (yalnızca .env.example takip edilir)
.env
.env.*
!.env.example

# Derleme çıktıları ve paketler
*.aab
*.apk
*.ipa
firebase/functions/node_modules/
firebase/functions/lib/
.firebase/

